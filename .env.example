# Runtime profile: local_native | docker_distributed
FINANCE_RUNTIME_MODE=local_native
FINANCE_DATA_DIR=.local_data
FINANCE_API_HOST=127.0.0.1
FINANCE_API_PORT=8040

# Local dev API keys (override in production via secret manager)
FINANCE_ADMIN_API_KEY=dev-finance-admin-key-change-me
FINANCE_AUDITOR_API_KEY=dev-finance-auditor-key-change-me
FINANCE_READER_API_KEY=dev-finance-reader-key-change-me

# Default deterministic simulation parameters
FINANCE_DEFAULT_SEED=20260505
FINANCE_DEFAULT_BOOKINGS=600
FINANCE_REPORTING_CURRENCY=USD

# Distributed profile settings (used by docker-compose.yml)
POSTGRES_USER=booking_oltp
POSTGRES_PASSWORD=change_me_postgres_local
POSTGRES_DB=booking_core
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=change_me_rustfs_local
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_local
OTEL_ARCH=arm64
